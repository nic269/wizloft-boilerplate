{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "defaultProfile",
    "sourceExcludes",
    "remove",
    "requiredApps",
    "optionalApps",
    "profiles",
    "validationCommands"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "defaultProfile": { "enum": ["saas", "core"] },
    "sourceExcludes": { "$ref": "#/$defs/uniqueStrings" },
    "remove": { "$ref": "#/$defs/uniqueStrings" },
    "requiredApps": {
      "allOf": [
        { "$ref": "#/$defs/uniqueStrings" },
        { "type": "array", "minItems": 1 }
      ]
    },
    "optionalApps": { "$ref": "#/$defs/uniqueStrings" },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saas", "core"],
      "properties": {
        "saas": { "$ref": "#/$defs/profile" },
        "core": { "$ref": "#/$defs/profile" }
      }
    },
    "validationCommands": { "$ref": "#/$defs/uniqueStrings" }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultApps"],
      "properties": {
        "defaultApps": {
          "allOf": [
            { "$ref": "#/$defs/uniqueStrings" },
            { "type": "array", "minItems": 1 }
          ]
        },
        "packages": { "$ref": "#/$defs/uniqueStrings" }
      }
    }
  }
}
