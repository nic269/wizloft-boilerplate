{
  "$schema": "./scripts/boilerplate-init/manifest.schema.json",
  "version": 2,
  "defaultProfile": "saas",
  "sourceExcludes": [
    ".agentkit",
    ".cache",
    ".data",
    ".env",
    ".git",
    ".next",
    ".omp",
    ".react-email",
    ".pnpm-store",
    ".turbo",
    ".wizloft",
    "build",
    "coverage",
    "desktop-dist",
    "dist",
    "node_modules",
    "out",
    "playwright-report",
    "storybook-static",
    "target",
    "test-results"
  ],
  "remove": [
    ".agents",
    ".claude",
    ".codex",
    ".history",
    "AGENTS.md",
    "docs",
    "new-tasks.md",
    "packages/biome-config",
    "packages/config/src/templates.test.ts",
    "packages/config/src/templates.ts",
    "packages/env",
    "plans",
    "release-manifest.json",
    "scripts/boilerplate-init",
    "scripts/README.md",
    "scripts/template-catalog.ts",
    "templates"
  ],
  "requiredApps": ["app", "api"],
  "optionalApps": ["web", "docs", "email", "storybook"],
  "profiles": {
    "saas": {
      "defaultApps": ["app", "web", "api", "email", "storybook"]
    },
    "core": {
      "defaultApps": ["app", "api"],
      "packages": [
        "api",
        "auth",
        "config",
        "database",
        "design-system",
        "helpers",
        "logger",
        "mail",
        "observability",
        "security",
        "test",
        "typescript-config"
      ]
    }
  },
  "validationCommands": [
    "pnpm check:ci",
    "pnpm check-types",
    "pnpm test",
    "pnpm boundaries",
    "pnpm build"
  ]
}
